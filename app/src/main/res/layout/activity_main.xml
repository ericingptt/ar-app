<?xml version="1.0" encoding="utf-8"?>
<!-- 直式版面：預覽在上、狀態面板在下。手持驗證時一手拿手機、一手在 ToF 前比手勢，
     面板不該蓋住預覽，所以改為上下堆疊而非浮動覆蓋。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080A0F"
    android:orientation="vertical">

    <SurfaceView
        android:id="@+id/cameraSurface"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:keepScreenOn="true" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/panel_background"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="佐臻 AR 硬體驗證"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/cameraStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="鏡頭：等待啟動"
            android:textColor="#DDE7F0"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tofStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="ToF：等待偵測"
            android:textColor="#DDE7F0"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/resolutionStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="解析度：—"
                android:textColor="#AFC0CF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/frameStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="影像幀：0"
                android:textColor="#AFC0CF"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Raw ToF telemetry and the USB grant state per device: together these separate
             "the sensor never opened" from "the sensor streams but recognises no gesture". -->
        <TextView
            android:id="@+id/tofDataStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="ToF 影格：0"
            android:textColor="#AFC0CF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/usbStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:text="USB：掃描中"
            android:textColor="#8FA6B8"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="最近手勢"
            android:textColor="#AFC0CF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/gestureText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="尚未偵測"
            android:textColor="#66D9FF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- Recent events with their raw SDK codes. The SDK documents no motion for any
             gesture, so the mapping has to be discovered on the device: make a motion, read
             which constant fired. -->
        <TextView
            android:id="@+id/gestureHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="monospace"
            android:maxLines="6"
            android:text="等待手勢事件…"
            android:textColor="#8FA6B8"
            android:textSize="12sp" />

        <!-- Holds crash traces as well as short errors: capped and scrollable so a long trace
             cannot squeeze the preview away, and selectable so it can be copied off-device. -->
        <TextView
            android:id="@+id/errorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:maxLines="9"
            android:scrollbars="vertical"
            android:textColor="#FFD0D8"
            android:textIsSelectable="true"
            android:textSize="11sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/retryButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/button_primary"
            android:text="重新連接"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <Button
            android:id="@+id/cibarButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/panel_background"
            android:text="開啟 CIBAR 體驗（手勢操控）"
            android:textAllCaps="false"
            android:textColor="#66D9FF"
            android:textSize="15sp" />
    </LinearLayout>
    </ScrollView>

</LinearLayout>
