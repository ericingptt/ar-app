<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080A0F"
    android:orientation="vertical">

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Shell-level status only: whether gestures are live. The injected bridge draws its own
         HUD inside the page for the gesture and focus readout. -->
    <TextView
        android:id="@+id/cibarStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#101520"
        android:padding="8dp"
        android:text="連線中…"
        android:textColor="#8FA6B8"
        android:textSize="12sp" />

</LinearLayout>
